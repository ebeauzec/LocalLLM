#
# This template is processed by lib/deploy.ps1 to generate the final
# docker-compose.yml. Placeholders ({{...}}) are replaced at install time.
# Conditional sections are marked with {{SECTION_START}}/{{SECTION_END}}.
#
# Architecture:
#   User → Open WebUI (frontend) → LiteLLM (router) → Ollama (local inference)
#                ↕                      ↕                     ↕
#           Pipelines (tools)    Cloud APIs (fallback)   GPU acceleration
#                ↕
#           SearXNG (search)
# ============================================================================

services:
  # ──────────────────────────────────────────────────────────────────────────
  # OLLAMA — Local Model Inference Engine
  # Runs AI models entirely on your hardware. No data leaves this container.
  # ──────────────────────────────────────────────────────────────────────────
  ollama:
    image: {{OLLAMA_IMAGE}}
    container_name: localllm-ollama
    ports:
      - "{{OLLAMA_PORT}}:11434"
    volumes:
      - "{{DATA_PATH}}/ollama:/root/.ollama"
    environment:
{{OLLAMA_ENV_VARS}}
{{ACCELERATOR_BLOCK}}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - localllm-network

  # ──────────────────────────────────────────────────────────────────────────
  # LITELLM — API Gateway & Router
  # Routes requests to local models first (free), cloud APIs as fallback.
  # Provides a unified OpenAI-compatible endpoint for all consumers.
  # ──────────────────────────────────────────────────────────────────────────
  litellm:
    image: ghcr.io/berriai/litellm:main-latest
    container_name: localllm-litellm
    ports:
      - "{{LITELLM_PORT}}:4000"
    volumes:
      - "{{CONFIG_PATH}}/litellm_config.yaml:/app/config.yaml"
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    environment:
      - LITELLM_MASTER_KEY={{LITELLM_KEY}}
      {{CLOUD_KEYS_ENV}}
    depends_on:
      ollama:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:4000/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 15s
    networks:
      - localllm-network

  # ──────────────────────────────────────────────────────────────────────────
  # OPEN WEBUI — Enterprise AI Frontend
  # Full-featured web interface with chat, RAG, tools, artifacts, code
  # execution, thinking display, MCP support, and admin dashboard.
  # ──────────────────────────────────────────────────────────────────────────
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: localllm-webui
    ports:
      - "{{WEBUI_PORT}}:8080"
    environment:
      # ── Model Connections ──
      - OLLAMA_BASE_URL=http://ollama:11434
      - OPENAI_API_BASE_URL=http://litellm:4000/v1
      - OPENAI_API_KEY={{LITELLM_KEY}}

      # ── Authentication ──
      - WEBUI_AUTH={{MULTI_USER}}

      # ── RAG Configuration ──
      - RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
      - RAG_EMBEDDING_ENGINE=ollama
      - CHUNK_SIZE=1000
      - CHUNK_OVERLAP=100
      - RAG_TOP_K=5
      - RAG_RELEVANCE_THRESHOLD=0.3

      # ── Enterprise Features ──
      - ENABLE_CODE_EXECUTION=True
      - ENABLE_ARTIFACTS=True
      - ENABLE_COMMUNITY_SHARING=False
      - ENABLE_MESSAGE_RATING=True
      - ENABLE_ADMIN_EXPORT=True

      # ── Web Search (SearXNG) ──
      {{RAG_WEB_SEARCH_ENV}}

      # ── Pipelines Server ──
      {{PIPELINES_ENV}}

      # ── Document Processing (Tika) ──
      {{TIKA_ENV}}

      # ── UI Configuration ──
      - DEFAULT_LOCALE=en
      - WEBUI_NAME=LocalLLM

    volumes:
      - "{{DATA_PATH}}/open-webui:/app/backend/data"
      - "{{DATA_PATH}}/uploads:/app/backend/data/uploads"
    depends_on:
      ollama:
        condition: service_healthy
      litellm:
        condition: service_healthy
    restart: always
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - localllm-network

  # ──────────────────────────────────────────────────────────────────────────
  # PIPELINES — Custom Tool Execution Server
  # Runs custom Python tools, code execution, and agentic workflows.
  # Extends Open WebUI with developer-grade capabilities.
  # ──────────────────────────────────────────────────────────────────────────
  {{PIPELINES_SECTION_START}}
  pipelines:
    image: ghcr.io/open-webui/pipelines:main
    container_name: localllm-pipelines
    ports:
      - "{{PIPELINES_PORT}}:9099"
    volumes:
      - "{{DATA_PATH}}/pipelines:/app/pipelines"
    environment:
      - PIPELINES_DIR=/app/pipelines
    restart: unless-stopped
    networks:
      - localllm-network
  {{PIPELINES_SECTION_END}}

  # ──────────────────────────────────────────────────────────────────────────
  # TIKA — Universal Document Parser & OCR Engine
  # Parses 100+ document formats locally. No data leaves this container.
  # Supports: PDF, Word, Excel, PowerPoint, images (OCR), HTML, and more.
  # ──────────────────────────────────────────────────────────────────────────
  {{TIKA_SECTION_START}}
  tika:
    image: apache/tika:latest-full
    container_name: localllm-tika
    ports:
      - "{{TIKA_PORT}}:9998"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9998/tika || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - localllm-network
  {{TIKA_SECTION_END}}

  # ──────────────────────────────────────────────────────────────────────────
  # SEARXNG — Private Web Search Engine
  # Provides web search without tracking, analytics, or data collection.
  # Search queries are proxied — your IP is hidden from search engines.
  # ──────────────────────────────────────────────────────────────────────────
  {{SEARXNG_SECTION_START}}
  searxng:
    image: searxng/searxng:latest
    container_name: localllm-searxng
    ports:
      - "{{SEARXNG_PORT}}:8080"
    volumes:
      - "{{CONFIG_PATH}}/searxng/settings.yml:/etc/searxng/settings.yml:ro"
      - "{{CONFIG_PATH}}/searxng/limiter.toml:/etc/searxng/limiter.toml:ro"
    environment:
      - SEARXNG_BASE_URL=http://localhost:{{SEARXNG_PORT}}/
    restart: unless-stopped
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    networks:
      - localllm-network
  {{SEARXNG_SECTION_END}}

# ──────────────────────────────────────────────────────────────────────────
# NETWORKING
# All services communicate on an isolated bridge network.
# Only explicitly exposed ports are accessible from the host.
# ──────────────────────────────────────────────────────────────────────────
networks:
  localllm-network:
    name: localllm-network
    driver: bridge
